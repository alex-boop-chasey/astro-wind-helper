---
import { SITE } from 'astrowind:config';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 relative inline-flex items-center">
  <span class="text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white">
    🚀 {SITE?.name}
  </span>
  <span
    class="text-5xl md:text-4xl font-cursive text-blue-600 dark:text-blue-400 ml-2"
    style="font-family: 'Brush Script MT', 'Lucida Handwriting', cursive; font-style: italic;"
  >
    helper
  </span>
</span>
